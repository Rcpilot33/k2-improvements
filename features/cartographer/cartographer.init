#!/bin/ash /etc/rc.common

START=50
USE_PROCD=1
DEPEND=fstab
PROG=/mnt/UDISK/bin/usb_bridge_new

start_service() {
    procd_open_instance
    procd_set_param command $PROG
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_set_param pidfile /var/run/cartographer.pid
    procd_close_instance
}

reload_service() {
    stop
    sleep 2
    start
    # Restarting the bridge upsets Klipper. Reset Klippy and the connected
    # MCUs, then wait for the K2 motor-controller startup to finish.
    SCRIPT_DIR=$(dirname "$(readlink -f /etc/init.d/cartographer)")
    sh "${SCRIPT_DIR}/../../scripts/firmware_restart.sh"
}
